{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "buildCommand": "python -c \"import shutil; shutil.copytree('../data', 'data', dirs_exist_ok=True)\"",
      "functions": {
        "app/main.py": {
          "includeFiles": "data/**",
          "maxDuration": 15
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
