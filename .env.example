# --- Backend (FastAPI) ---
# Directory containing the committed snapshot (actuals*.parquet, forecasts.parquet, ingest_report.json)
DATA_DIR=./data
# Comma-separated list of allowed browser origins, or * for all (dev only)
CORS_ORIGINS=*
# Enable the optional live-refresh endpoint that re-pulls data from BMRS (default off)
ENABLE_LIVE_REFRESH=0

# --- Frontend (Vite) ---
# Base URL of the API when the frontend is served separately from the backend.
# Leave empty to use the Vite dev proxy (dev) or same-origin (nginx/prod).
VITE_API_BASE=
# Dev proxy target for /api
VITE_API_PROXY=http://localhost:8000
